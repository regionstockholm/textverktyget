datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

model PromptTemplate {
  // One active version per name is enforced by the partial unique index in migrations.
  id        Int      @id @default(autoincrement())
  name      String
  content   String
  version   Int
  isActive  Boolean  @default(false) @map("is_active")
  updatedAt DateTime @default(now()) @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@unique([name, version])
  @@index([name, isActive])
  @@map("prompt_templates")
}

model ProviderConfig {
  provider        String   @id
  model           String
  modelProfile    String?  @map("model_profile")
  temperature     Float
  maxOutputTokens Int      @map("max_output_tokens")
  useWebSearch    Boolean  @default(false) @map("use_web_search")
  useThinking     Boolean  @default(true) @map("use_thinking")
  contextWindow   Int?     @map("context_window")
  taskModel       String?  @map("task_model")
  backgroundModel String?  @map("background_model")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("provider_configs")
}

model GlobalConfig {
  configKey        String   @id @map("config_key")
  provider         String
  retryCount       Int      @default(2) @map("retry_count")
  rewritePlanTasks Json?    @map("rewrite_plan_tasks")
  runtimeSettings  Json?    @map("runtime_settings")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedBy        String?  @map("updated_by")

  @@map("global_config")
}

model TaskDefinition {
  id                    Int      @id @default(autoincrement())
  key                   String   @unique @map("task_key")
  label                 String
  description           String?
  enabled               Boolean  @default(true)
  sortOrder             Int      @map("sort_order")
  bulletCount           Int?     @map("bullet_count")
  maxChars              Int?     @map("max_chars")
  targetAudienceEnabled Boolean  @default(true) @map("target_audience_enabled")
  rewritePlanEnabled    Boolean  @default(true) @map("rewrite_plan_enabled")
  reasoningEnabled      Boolean  @default(true) @map("reasoning_enabled")
  webSearchMode         String   @default("inherit") @map("web_search_mode")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([enabled, sortOrder])
  @@index([sortOrder])
  @@map("task_definitions")
}

model OrdlistaEntry {
  id        Int      @id @default(autoincrement())
  fromWord  String   @map("from_word")
  toWord    String   @map("to_word")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@unique([fromWord])
  @@map("ordlista_entries")
}

model Secret {
  name       String   @id
  cipherText String   @map("cipher_text")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")

  @@map("secrets")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  actor     String?
  entity    String
  entityId  String?  @map("entity_id")
  diff      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}

// Owned by connect-pg-simple; modeled here so subsequent migrations preserve it.
model UserSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "idx_user_sessions_expire")
  @@map("user_sessions")
}

// Immutable username snapshot, deliberately not a foreign key to an account.
model SubmissionLog {
  id         Int      @id @default(autoincrement())
  username   String
  text       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt, id])
  @@map("submission_logs")
}

model SubmissionLogSettings {
  key           String   @id
  retentionDays Int?     @map("retention_days")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("submission_log_settings")
}

model TextQualityControl {
  id                Int      @id @default(autoincrement())
  sessionId         String   @map("session_id")
  originalText      String   @map("original_text")
  processedText     String   @map("processed_text")
  promptUsed        String?  @map("prompt_used")
  processingOptions String?  @map("processing_options")
  rewritePlanDraft  String?  @map("rewrite_plan_draft")
  score             Float?
  iteration         Int      @default(1)
  status            String   @default("pending")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([sessionId], map: "idx_text_quality_session")
  @@index([status], map: "idx_text_quality_status")
  @@index([createdAt], map: "idx_text_quality_created_at")
  @@map("text_quality_control")
}
