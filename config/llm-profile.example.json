{
  "provider": "local",
  "id": "my-ollama-qwen",
  "apiModelId": "qwen3:32b",
  "displayName": "My Qwen3 32B server",
  "limits": {
    "contextWindow": 32768,
    "maxOutputTokens": 16384,
    "verification": "deployment-dependent"
